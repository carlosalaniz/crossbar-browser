            "text": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Verification required</title>\n<style>body{font:16px system-ui,sans-serif;max-width:560px;margin:10vh auto;padding:16px}h1{font-size:28px}</style></head>\n<body>\n<h1>site-a.test</h1>\n<h2 id=\"challenge-title\">Verification required</h2>\n<p id=\"challenge-body-text\">Solve the puzzle to continue.</p>\n<form method=\"POST\" action=\"/__captcha/clear\" data-captcha id=\"challenge-form\">\n<input type=\"hidden\" name=\"provider\" value=\"arkose\">\n<input type=\"hidden\" name=\"return_to\" value=\"/gated/article?mode=always&amp;style=interstitial&amp;provider=arkose\">\n<div id=\"arkose-enforcement\" class=\"arkose-enforcement\" data-arkose data-sitekey=\"testsite-fake\" data-testsite-fake=\"arkose\">\n  <iframe src=\"http://captcha.test/client-api.arkoselabs.com/fc/assets/ec-game-core/game-core/fake/standard/index.html\" title=\"Arkose Labs (FunCaptcha) (test-site fake)\" width=\"304\" height=\"78\" style=\"border:1px solid #bbb;border-radius:4px\" sandbox=\"allow-scripts allow-same-origin\"></iframe>\n  <input type=\"hidden\" name=\"fc-token\" value=\"\">\n</div>\n<script>\naddEventListener(\"message\", (e) => {\n  const d = e.data;\n  if (!d || d.type !== \"testsite-captcha\" || d.provider !== \"arkose\") return;\n  if (new URL(\"http://captcha.test/client-api.arkoselabs.com/fc/assets/ec-game-core/game-core/fake/standard/index.html\").origin !== e.origin) return;\n  const f = document.querySelector('input[name=\"fc-token\"]');\n  f.value = d.token;\n  f.form.submit();\n});\n</script>\n<noscript><button>Continue</button></noscript>\n</form>\n\n</body></html>"
