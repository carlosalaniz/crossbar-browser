# One build, three images: --target app | browser | proxy.
ARG NODE_IMAGE=node:26-bookworm-slim

FROM ${NODE_IMAGE} AS deps
WORKDIR /src
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY server/package.json server/
COPY auth/package.json auth/
COPY browser/package.json browser/
COPY proxy/package.json proxy/
COPY detect/package.json detect/
COPY adapters/package.json adapters/
COPY web/package.json web/
RUN npm ci --ignore-scripts --no-audit --no-fund && npm rebuild esbuild

FROM deps AS build
COPY . .
RUN node scripts/build-web.mjs && npm prune --omit=dev --ignore-scripts && rm -rf .cache web/src web/test */test/pages/*.png

# ---- app: API, web app, MCP, login, database. Public + internal networks. ----
FROM ${NODE_IMAGE} AS app
ENV NODE_ENV=production CROSSBAR_DATA=/data CROSSBAR_PORT=8080
WORKDIR /app
COPY --from=build --chown=node:node /src /app
RUN mkdir -p /data && chown node:node /data
USER node
EXPOSE 8080
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "server/src/main.ts"]

# ---- proxy: the browser's only way out. Internal + egress networks. ----
FROM ${NODE_IMAGE} AS proxy
WORKDIR /app
COPY --from=build --chown=node:node /src/package.json /app/
COPY --from=build --chown=node:node /src/proxy /app/proxy
# Marks a production build: the dev-only test-site allowlist refuses to start here (proxy/src/dev-allowlist.ts).
RUN touch /app/proxy/PRODUCTION_BUILD
ENV CROSSBAR_BUILD=production
USER node
EXPOSE 3128
CMD ["node", "proxy/src/main.ts"]

# ---- proxy-dev: the same proxy, not marked production, so CROSSBAR_DEV_TESTSITE=1 can work. `npm run dev` only. ----
FROM proxy AS proxy-dev
USER root
RUN rm -f /app/proxy/PRODUCTION_BUILD
ENV CROSSBAR_BUILD=dev
USER node

# ---- browser: headful Chromium under Xvfb, behind the proxy. Internal network only. ----
FROM debian:trixie-slim AS browser
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium xvfb xauth fonts-liberation fonts-noto-core fonts-noto-color-emoji fonts-noto-cjk ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*
COPY --from=deps /usr/local/bin/node /usr/local/bin/node
COPY deploy/browser/policies.json /etc/chromium/policies/managed/crossbar.json
RUN useradd -m -u 1000 crossbar && mkdir -p /profiles && chown crossbar:crossbar /profiles
WORKDIR /app
COPY --from=build --chown=crossbar:crossbar /src/package.json /app/
COPY --from=build --chown=crossbar:crossbar /src/node_modules /app/node_modules
COPY --from=build --chown=crossbar:crossbar /src/browser /app/browser
ENV CHROME_PATH=/usr/bin/chromium CROSSBAR_PROFILES=/profiles CROSSBAR_HEADLESS=0
USER crossbar
EXPOSE 9300
VOLUME ["/profiles"]
ENTRYPOINT ["tini", "--"]
CMD ["xvfb-run", "-a", "--server-args=-screen 0 1920x1080x24 -nolisten tcp", "node", "browser/src/host.ts"]

# ---- browser for hosts without internal networks (Harbor): firewalls itself to the proxy, then
# drops root and all capabilities. Needs NET_ADMIN (Harbor's net-admin permission). ----
FROM browser AS browser-firewalled
USER root
RUN apt-get update && apt-get install -y --no-install-recommends iptables util-linux && rm -rf /var/lib/apt/lists/*
COPY --chmod=0755 deploy/browser/egress-firewall.sh /usr/local/bin/egress-firewall
CMD ["egress-firewall"]

FROM app
